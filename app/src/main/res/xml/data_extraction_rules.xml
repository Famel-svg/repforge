<?xml version="1.0" encoding="utf-8"?>
<!-- Workout data lives only on the device, so cloud backup and device transfer carry the database and preferences. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
        <exclude domain="file" path="datastore/repforge_pro.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
        <exclude domain="file" path="datastore/repforge_pro.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
