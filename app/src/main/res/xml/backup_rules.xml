<?xml version="1.0" encoding="utf-8"?>
<!-- Workout data lives only on the device, so the system backup carries the database and preferences. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="datastore" />
    <exclude domain="file" path="datastore/repforge_pro.preferences_pb" />
</full-backup-content>
